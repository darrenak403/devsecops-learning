# Local Docker stack only — replace JWT_SECRET_KEY before any shared deploy.
# DATABASE_URL / ASYNC_DATABASE_URL / REDIS_URL are set in docker-compose.yml.

APP_NAME=Beyond8 Auth Service
API_PREFIX=/api
EXPOSE_API_DOCS=true

JWT_SECRET_KEY=change-me-local-docker-only
JWT_ALGORITHM=HS256
COURSE_ACCESS_TOKEN_EXPIRE_DAYS=30

KEY_PREFIX=BY8
OTP_TTL_SECONDS=60
OTP_REFRESH_COOLDOWN_SECONDS=60

REDIS_ENABLED=true

RUN_STARTUP_BOOTSTRAP=true
